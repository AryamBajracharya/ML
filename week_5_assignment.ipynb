   "source": [
    "# Broadcasting: It allows us to add a vector to each row of the matrix\n",
    "import numpy as np\n",
    "\n",
    "matrix = np.array([[1, 2, 3], [4, 5, 6]])\n",
    "\n",
    "vector = np.array([10, 20, 30])\n",
    "\n",
    "result = matrix + vector\n",
    "\n",
    "print(\"Result:\")\n",
    "print(result)\n"
   ]
  },
